<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="plagiarism/pcx/db" VERSION="2026112400" COMMENT="XMLDB file for plagiarism_pcx"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="plagiarism_pcx_files" COMMENT="One check per submission item (online text or one file)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cm" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course module id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Submitting user"/>
        <FIELD NAME="itemkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="onlinetext, or the file's pathnamehash"/>
        <FIELD NAME="identifier" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Hash of what was checked, to spot later edits"/>
        <FIELD NAME="scanid" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="The API's scan id"/>
        <FIELD NAME="modules" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Checks requested, comma separated"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending, done, failed"/>
        <FIELD NAME="results" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: per check, the numbers shown"/>
        <FIELD NAME="reporturl" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Full report in the app"/>
        <FIELD NAME="error" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="cm" TYPE="foreign" FIELDS="cm" REFTABLE="course_modules" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmuseritem" UNIQUE="true" FIELDS="cm, userid, itemkey"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status, timemodified"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="plagiarism_pcx_config" COMMENT="Per-activity settings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cm" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="value" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="cm" TYPE="foreign" FIELDS="cm" REFTABLE="course_modules" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmname" UNIQUE="true" FIELDS="cm, name"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
